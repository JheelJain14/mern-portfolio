# Server Configuration
PORT=5000

# MongoDB Connection String (Replace with your local MongoDB or Atlas URI)
# Example Local: mongodb://127.0.0.1:27017/portfolio_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# Allowed Frontend Origin for CORS
CLIENT_URL=http://localhost:5173
